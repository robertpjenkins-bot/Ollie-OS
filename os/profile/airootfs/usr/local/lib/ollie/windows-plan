#!/bin/bash
# Windows, as asked for at the end of the Drive Writer (os/usb/ollie-install-drive),
# done at the drive's first start, as root (ollie-windows-plan.service). The
# Drive Writer leaves its answers on the start-up part, /boot/ollie-windows-plan:
#   MENU=1                 Windows (already on the computer) on the start-up
#                          menu: ollie-windows-boot.service is switched on
#   VERSION=10|11 GB=N     install Windows next to Ollie OS: N GB are left
#                          empty for Windows and a Windows Setup part
#                          (OLLIE_WINSETUP, 10 GB) is made, by windows-layout:
#                          from free room already on the drive if there is
#                          enough, else Ollie OS's part is made smaller (its
#                          btrfs, then the partition) and the room goes right
#                          after it. Then "Install Windows" opens at the next
#                          login to get Windows Setup ready (from the Windows
#                          .iso the Add Windows Updater saved in /var/lib/ollie,
#                          else from Microsoft) and start it.
# The file is used once (taken away first, so this never runs twice). What
# happens is in the journal (journalctl -u ollie-windows-plan).
set -uo pipefail
plan=/boot/ollie-windows-plan
[[ -f $plan ]] || exit 0
val() { sed -n "s/^$1=//p" "$plan" | tail -n 1 | tr -cd '0-9'; }
menu="$(val MENU)" version="$(val VERSION)" gb="$(val GB)"
rm -f -- "$plan"
sync
fail() { echo "Windows could not be got ready: $*" >&2; exit 1; }

if [[ $menu == 1 ]]; then
    systemctl enable --now ollie-windows-boot.service && echo "Windows on the start-up menu: switched on."
fi
[[ ($version == 10 || $version == 11) && -n $gb ]] || exit 0

# Ollie OS's part: btrfs. The room for Windows and Windows Setup's part are
# made by windows-layout: from free room already on the drive if there is
# enough (Ollie OS's part is not touched), else by making Ollie OS's part
# smaller (its btrfs first, then the part), the room going right after it.
# Other parts on the drive are never touched. Old Windows Setup parts (an
# earlier try) are taken away first.
src="$(findmnt -no SOURCE / | sed 's/\[.*//')"
[[ "$(findmnt -no FSTYPE /)" == btrfs && -b $src ]] || fail "Ollie OS's part is not btrfs."
name="${src#/dev/}"
disk="/dev/$(lsblk -no PKNAME "$src" | head -n 1)"
num="$(cat "/sys/class/block/$name/partition")"
[[ -n $num && -b $disk ]] || fail "Ollie OS's part could not be looked up."
[[ "$(lsblk -dno PTTYPE "$disk")" == gpt ]] || fail "$disk is not a GPT drive: the room for Windows cannot be made on it."
((gb >= (version == 11 ? 64 : 32))) || fail "$gb GB is too little for Windows $version."
# shellcheck source=/dev/null
. "${OLLIE_WINDOWS_LAYOUT:-/usr/local/lib/ollie/windows-layout}"

wl_hook_fs_shrink() { # the btrfs gets $1 GiB smaller (when it has the room)
    local free
    free="$(btrfs filesystem usage -b / 2>/dev/null | awk '/Free \(estimated\)/ {print $3; exit}')"
    ((${free:-0} > ($1 + 8) * 1073741824)) || { echo "not enough free room in Ollie OS's part for $gb GB of Windows." >&2; return 1; }
    btrfs filesystem resize "-${1}g" / >/dev/null
}
wl_hook_kernel() { # wl_hook_kernel DISK NUM|new: tell the kernel about the part table change
    local info ss
    if [[ $2 == new ]]; then
        partx -a "$1" 2>/dev/null || partx -u "$1" 2>/dev/null
        return 0
    fi
    info="$(wl_part_info "$1" "$2")"
    if [[ -n $info ]]; then # still there, smaller
        ss="$(wl__ss "$1")"
        resizepart "$1" "$2" $((${info#* } * ss / 512)) 2>/dev/null || partx -u "$1" 2>/dev/null
    else # taken away
        partx -d --nr "$2" "$1" 2>/dev/null
    fi
    return 0
}

wl_plan "$disk" "$num" "$gb" || fail "the room for Windows could not be made (see above)."
udevadm settle 2>/dev/null

install -D -m 0644 /dev/stdin /etc/ollie/windows <<EOF
VERSION=$version
EOF
# "Install Windows" in the apps menu, and once at the next login.
install -m 0644 /usr/local/share/ollie/ollie-windows-install.desktop /usr/share/applications/
sed -e 's#^Exec=.*#Exec=/usr/local/bin/ollie-windows-install --at-login#' /usr/local/share/ollie/ollie-windows-install.desktop >/etc/xdg/autostart/ollie-windows-install.desktop
systemctl enable ollie-windows-boot.service >/dev/null 2>&1
echo "Room for Windows $version is ready: Install Windows opens at the next login."
