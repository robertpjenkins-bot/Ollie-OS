#!/bin/bash
# Install Windows (in the apps menu when Ollie OS was installed with Windows):
# gets Windows Setup ready again on this drive's Windows Setup part, from
# Microsoft or from an ISO file (for when the installer could not, or to
# start over), then restarts into Windows Setup (ollie-windows-setup).
#   ollie-windows-install [--at-login]   (--at-login: opened by itself after
#   the Drive Writer's first start made room for Windows; it asks first)
set -uo pipefail
readonly TITLE="Install Windows"
version="$(sed -n 's/^VERSION=//p' /etc/ollie/windows 2>/dev/null)"
version="${version:-11}"
# A Windows the Add Windows Updater already downloaded (ollie-add-windows).
ready="/var/lib/ollie/windows-$version.iso"
[[ -s $ready ]] || ready=""

if [[ ${1:-} == --at-login ]]; then
    [[ -f /boot/loader/entries/windows.conf ]] && exit 0
    kdialog --title "$TITLE" --icon ollie-restart-windows --yes-label "Yes, now" --no-label "Later" --yesno \
        "The room for Windows $version is ready on this drive. Get Windows $version Setup ready now?

$([[ -n $ready ]] && echo "Windows $version is already downloaded." || echo "It needs the internet (about 6 GB), or a Windows .iso file you have.")
(Later: open \"Install Windows\" from the apps menu.)" || exit 0
fi
if [[ -f /boot/loader/entries/windows.conf ]]; then
    kdialog --title "$TITLE" --msgbox "Windows $version is already installed. Pick it on the start-up menu when the computer starts."
    exit 0
fi
if ! lsblk -lno PARTLABEL | grep -qx OLLIE_WINSETUP; then
    kdialog --title "$TITLE" --sorry "This drive has no room kept for Windows.

Windows can be installed next to Ollie OS when Ollie OS is installed: start from
the Ollie OS USB, press Install Ollie OS, and say yes to Windows."
    exit 0
fi

if [[ -n $ready ]]; then
    from=ready
else
from="$(kdialog --title "$TITLE" --geometry 640x260 --radiolist "Get Windows $version Setup ready. Where does Windows $version come from?" \
    download "Download it from Microsoft (about 6 GB)" on \
    file "A Windows $version .iso file I already have" off \
    page "Open Microsoft's download page (download it there, then come back and pick the file)" off)" || exit 0
fi
args=(--version "$version")
case "$from" in
ready)
    args+=(--iso "$ready")
    ;;
page)
    xdg-open "https://www.microsoft.com/software-download/windows$version$([[ $version == 10 ]] && echo ISO)" >/dev/null 2>&1 &
    exit 0
    ;;
file)
    iso="$(kdialog --title "Pick the Windows $version ISO" --getopenfilename "$HOME/Downloads" "*.iso|Windows ISO files")" || exit 0
    [[ -n $iso ]] || exit 0
    args+=(--iso "$iso")
    ;;
esac

log="$(mktemp)"
bar="$(kdialog --title "$TITLE" --progressbar "Getting Windows $version Setup ready..." 100)"
qdbus6 $bar showCancelButton false >/dev/null 2>&1
sudo -n /usr/local/bin/ollie-windows-setup "${args[@]}" 2>"$log" | tee -a "$log" |
    while read -r word pct text; do
        [[ $word == PROGRESS ]] || continue
        qdbus6 $bar Set "" value "$pct" >/dev/null 2>&1
        qdbus6 $bar setLabelText "$text... ($pct%)" >/dev/null 2>&1
    done
rc=${PIPESTATUS[0]}
qdbus6 $bar close >/dev/null 2>&1
if ((rc == 0)) && [[ -n $ready ]]; then
    sudo -n rm -f -- "$ready" # it is on the Windows Setup part now
fi
if ((rc != 0)); then
    kdialog --title "$TITLE" --error "Windows $version Setup could not be got ready:

$(sed -n 's/^Error: //p' "$log" | tail -n 1)"
    rm -f "$log"
    exit 1
fi
next="$(grep -c '^NEXT-START ' "$log")"
rm -f "$log"
if kdialog --title "$TITLE" --yes-label "Restart now" --no-label "Later" --yesno "Windows $version Setup is ready.

$( ((next)) && echo "When the computer restarts, Windows Setup starts." || echo "When the computer restarts, pick \"WINSETUP\" in its start-up menu (Dell: F12, Mac: hold Option).") In Windows Setup:
  1. Pick your language and keyboard, then Install.
  2. No product key? Press \"I don't have a product key\".
  3. Where to install it: pick \"Unallocated Space\", then Next.
     Don't delete or format the other parts: they are Ollie OS.
Afterwards the start-up menu shows Ollie OS and Windows $version."; then
    systemctl reboot
fi
