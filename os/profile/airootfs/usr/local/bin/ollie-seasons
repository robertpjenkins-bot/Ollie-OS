#!/bin/bash
# Seasonal themes: Ollie OS changes by itself for Halloween (15 to 31
# October), winter (1 December to 6 January) and your birthday (set in Ollie
# OS Settings; 23 November until then): its own background (only when the background is one of Ollie
# OS's, never a picture you chose), a hello from Ollie, the pet's hat, and a
# party on your birthday. Back to normal afterwards.
#   ollie-seasons --watch   (at login, /etc/xdg/autostart) checks every half minute
#   ollie-seasons --now     which season it is: halloween|winter|birthday|none
# Settings: ~/.config/ollie/seasons (SEASONS=on|off, BIRTHDAY=MM-DD; with no
# birthday set, 23 November is it, biobro's); the
# season shown now: ~/.config/ollie/season-now (the pet and Welcome read it).
set -uo pipefail
cfg="$HOME/.config/ollie"
mkdir -p "$cfg"
setting() { sed -n "s/^$1=//p" "$cfg/seasons" 2>/dev/null | tail -n 1; }

season() {
    [[ "$(setting SEASONS)" == off ]] && { echo none; return; }
    local md birthday
    md="$(date +%m-%d)" birthday="$(setting BIRTHDAY)"
    birthday="${birthday:-11-23}"
    if [[ -n $birthday && $md == "$birthday" ]]; then echo birthday
    elif [[ $md > 10-14 && $md < 11-01 ]]; then echo halloween
    elif [[ $md > 11-30 || $md < 01-07 ]]; then echo winter
    else echo none
    fi
}
[[ ${1:-} == --now ]] && { season; exit 0; }

# The desktop's background now, and whether it is one of Ollie OS's.
current_wallpaper() { grep -h '^Image=' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" 2>/dev/null | sed 's/^Image=//; s|^file://||'; }
# (Every background the desktop has is Ollie OS's own, or there is none: never a picture you chose.)
ollie_wallpaper() {
    local w
    while IFS= read -r w; do
        [[ -z $w || $w == /usr/share/wallpapers/OllieOS* ]] || return 1
    done <<<"$1"
    return 0
}
normal_wallpaper() {
    case "$(sed -n 's/^COLOUR=//p' "$cfg/colours" 2>/dev/null | tail -n 1)" in
    purple) echo /usr/share/wallpapers/OllieOS-Purple ;;
    red) echo /usr/share/wallpapers/OllieOS-Red ;;
    gold) echo /usr/share/wallpapers/OllieOS-Gold ;;
    *) echo /usr/share/wallpapers/OllieOS ;;
    esac
}

# The first start's questions (ollie-first-setup: create a username and
# password) are still to come or still open. That script asks until one of
# the files below exists (same test here, in the automatic "ollie" session),
# but its last window ("All set") opens after the account is made: so also
# while the script is running.
first_start_pending() {
    local f
    pgrep -u "$UID" -f ollie-first-setup >/dev/null 2>&1 && return 0
    [[ "$(id -un)" == ollie && -f /etc/sddm.conf.d/20-autologin.conf ]] || return 1
    for f in /var/lib/ollie/setup-done /run/ollie-bootdir/ollie-account.conf /run/ollie-bootdir/ollie-setup-skipped; do
        [[ -e $f ]] && return 1
    done
    return 0
}

apply() {
    local now applied wall name
    now="$(season)" applied="$(cat "$cfg/season-now" 2>/dev/null || echo none)"
    [[ $now == "$applied" ]] && return
    # Not on top of the first start's questions: they come first (the
    # watcher asks again half a minute later).
    first_start_pending && return
    echo "$now" >"$cfg/season-now"
    case $now in
    halloween) wall=/usr/share/wallpapers/OllieOS-Halloween ;;
    winter) wall=/usr/share/wallpapers/OllieOS-Winter ;;
    birthday) wall=/usr/share/wallpapers/OllieOS-Birthday ;;
    *) wall="$(normal_wallpaper)" ;;
    esac
    if ollie_wallpaper "$(current_wallpaper)" && [[ -d $wall ]]; then
        plasma-apply-wallpaperimage "$wall" >/dev/null 2>&1
    fi
    name="$(getent passwd "${USER:-$(id -un)}" | cut -d: -f5 | cut -d, -f1)"
    case $now in
    halloween)
        notify-send -a "Ollie OS" -i ollie-os "Happy Halloween" "Ollie OS is dressed up for Halloween." 2>/dev/null
        ;;
    winter)
        notify-send -a "Ollie OS" -i ollie-os "It's winter" "Ollie OS is ready for the snow." 2>/dev/null
        ;;
    birthday)
        QT_FORCE_STDERR_LOGGING=1 qml6 /usr/local/share/ollie/birthday.qml -- "name=$name" >/dev/null 2>&1 &
        ;;
    esac
}

if [[ ${1:-} == --watch ]]; then
    sleep 20 # (the desktop first)
    me="$(readlink -f "$0")" stamp="$(stat -c %Y "$me" 2>/dev/null)"
    while :; do
        apply
        # Every half minute (so a changed clock shows soon), and a newer
        # Ollie OS update of this script takes over without logging out.
        sleep 30
        [[ "$(stat -c %Y "$me" 2>/dev/null)" == "$stamp" ]] || exec "$me" --watch
    done
fi
apply
