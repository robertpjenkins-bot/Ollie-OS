#!/bin/bash
# Finishes Windows' first start-up when it was put on by the USB way
# (ollie-windows-setup, windows-usb-install.cmd). Windows restarts a few
# times while it sets itself up, and each restart comes back to Ollie OS's
# start-up menu (Ollie OS first). Until Windows says it is finished, this
# restarts the computer straight into Windows each time Ollie OS starts, so
# the person does not have to pick it. Windows says it is finished by a file,
# ollie-windows-ready.txt, at the top of its part (written by its first-start
# script, SetupComplete.cmd). It tries at most 5 times.
# Runs at each start while /var/lib/ollie/windows-firstboot is there
# (ollie-windows-finish.service); ollie-windows-boot makes that file.
#   ollie-windows-finish
set -uo pipefail
[[ $EUID -eq 0 ]] || exec sudo -n "$0" "$@"
readonly STATE="${OLLIE_FINISH_STATE:-/var/lib/ollie/windows-firstboot}"
readonly MAX=5
[[ -f $STATE ]] || exit 0

tries="$(tr -cd '0-9' <"$STATE")"
tries="${tries:-0}"
wdev="$(lsblk -lnpo NAME,PARTLABEL 2>/dev/null | awk '$2 == "OLLIE_WINDOWS" {print $1; exit}')"
if [[ -z $wdev ]]; then
    echo "ollie-windows-finish: no part for Windows is there; nothing to wait for."
    rm -f "$STATE"
    exit 0
fi
if ntfsls "$wdev" 2>/dev/null | grep -qx ollie-windows-ready.txt; then
    echo "ollie-windows-finish: Windows has finished setting itself up."
    rm -f "$STATE"
    exit 0
fi
if ((tries >= MAX)); then
    echo "ollie-windows-finish: tried $MAX times; stopping. Pick Windows in the start-up menu to carry on."
    rm -f "$STATE"
    exit 0
fi
echo $((tries + 1)) >"$STATE"
echo "ollie-windows-finish: Windows has not finished setting itself up: restarting into it (try $((tries + 1)) of $MAX)."
command -v plymouth >/dev/null && plymouth display-message --text="Going on with Windows..." 2>/dev/null
exec "${OLLIE_RESTART_WINDOWS:-/usr/local/bin/ollie-restart-windows}"
