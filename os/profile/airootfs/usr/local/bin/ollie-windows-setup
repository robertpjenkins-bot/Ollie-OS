#!/bin/bash
# Gets Windows Setup ready next to Ollie OS: the Windows 10 or 11 ISO
# (downloaded from Microsoft, or a file you have) is unpacked onto this
# drive's Windows Setup part (partition name OLLIE_WINSETUP, made by
# ollie-install when you asked for Windows), and the computer starts Windows
# Setup the next time it restarts (just that once: the start-up list's
# BootNext). In Windows Setup you pick "Unallocated Space" (the space kept
# for Windows); Ollie OS is not touched. When Windows is installed, Ollie
# OS's start-up menu shows "Windows 11" (or 10) next to Ollie OS
# (ollie-windows-boot), and this part is removed again.
#
# Windows Setup gets, next to it:
#   autounattend.xml: the account the Add Windows Updater asked for (Windows
#       makes it by itself, no questions; its login screen asks for the
#       password), and: Windows 11 installs on computers without TPM 2.0 or
#       Secure Boot too (Microsoft's LabConfig switches). Nothing else is
#       answered: Setup still asks where to install, and nothing is wiped.
#   SetupComplete.cmd (run once by Windows at the end of Setup): Windows
#       Boot Manager starts Ollie OS's menu, so both stay on it; the clock is
#       kept in UTC like Ollie OS (no wrong time after switching); automatic
#       BitLocker drive encryption is off (it would ask for a recovery key
#       because of the menu).
#
#   ollie-windows-setup --version 10|11 [--iso FILE|DIR] [--part DEVICE]
#                       [--work DIR] [--root DIR] [--no-efi-vars]
#     --iso      a Windows ISO you have (or a folder with one unpacked);
#                without it, the newest is downloaded from Microsoft (about
#                6 GB, into --work: deleted once it is on the drive)
#     --part     the Windows Setup part (default: OLLIE_WINSETUP on the drive
#                Ollie OS starts from)
#     --usb      yes | no | auto (default): a drive connected by USB is one Windows
#                Setup refuses to install to ("does not support installation to
#                disks connected through a USB port"). Then Setup is not run: its
#                start-up image gets a script instead (windows-usb-install.cmd)
#                that puts Windows on an empty NTFS part (made here, in the free
#                room, called OLLIE_WINDOWS) with DISM and BCDBOOT, which have
#                no such check, and restarts. ollie-windows-boot then puts that
#                Windows on Ollie OS's start-up menu.
#     --root     the Ollie OS to note it in (/etc/ollie/windows; default /)
# Prints "PROGRESS percent text" lines. As root.
set -uo pipefail
[[ $EUID -eq 0 ]] || exec sudo -n "$0" "$@"

version="" iso="" part="" work=/var/tmp root=/ efi_vars=1 label_check=1 usb=auto winpart=""
while (($#)); do
    case "$1" in
    --version) version="$2"; shift 2 ;;
    --iso) iso="$2"; shift 2 ;;
    --part) part="$2"; shift 2 ;;
    --work) work="$2"; shift 2 ;;
    --root) root="$2"; shift 2 ;;
    --no-efi-vars) efi_vars=""; shift ;;
    --no-label-check) label_check=""; shift ;; # for tests: any block device
    --usb) usb="$2"; shift 2 ;;               # yes | no | auto (auto: the drive is connected by USB)
    --windows-part) winpart="$2"; shift 2 ;;  # for tests: the part Windows goes in (else made in the free room)
    *) echo "Unknown option $1" >&2; exit 2 ;;
    esac
done
die() { echo "Error: $*" >&2; exit 1; }
progress() { echo "PROGRESS $1 $2"; }
[[ $version == 10 || $version == 11 ]] || die "--version must be 10 or 11."

# The Windows Setup part.
if [[ -z $part ]]; then
    bootdisk="$(lsblk -no PKNAME "$(findmnt -no SOURCE /boot | sed 's/\[.*//')" 2>/dev/null | head -n 1)"
    part="$(lsblk -lnpo NAME,PARTLABEL ${bootdisk:+"/dev/$bootdisk"} | awk '$2 == "OLLIE_WINSETUP" {print $1; exit}')"
fi
[[ -b $part && ( -z $label_check || "$(lsblk -no PARTLABEL "$part")" == OLLIE_WINSETUP ) ]] ||
    die "this drive has no Windows Setup part. It is made when Ollie OS is installed with Windows: install Ollie OS again and say yes to Windows."
disk="/dev/$(lsblk -no PKNAME "$part" | head -n 1)"
partnum="$(cat "/sys/class/block/${part#/dev/}/partition")"
if [[ -n $efi_vars && ! -d /sys/firmware/efi ]]; then
    die "this computer started the old way (BIOS / Legacy). Windows Setup needs it to start the new way (UEFI): change it in the computer's start-up settings."
fi

tmp="$(mktemp -d)"
cleanup() {
    for m in "$tmp/setup" "$tmp/iso"; do mountpoint -q "$m" && umount "$m"; done
    # The downloaded ISO goes once it is on the drive; a half-downloaded one
    # stays, so trying again goes on from where it stopped.
    [[ -n ${downloaded:-} ]] && rm -f -- "$downloaded"
    rm -rf -- "$tmp"
}
trap cleanup EXIT
mkdir -p "$tmp/setup" "$tmp/iso"

# --- The ISO ---------------------------------------------------------------------------------
downloaded=""
if [[ -z $iso ]]; then
    progress 1 "Asking Microsoft for Windows $version"
    link="$(python3 -I /usr/local/lib/ollie/get-windows.py "$version")" || die "Windows $version could not be downloaded automatically. Download the ISO on Microsoft's page (microsoft.com/software-download/windows$version), then pick the file."
    mkdir -p "$work"
    (($(df -B1 --output=avail "$work" | tail -n 1) > 8 * 1024 * 1024 * 1024)) || die "not enough free space to download Windows (8 GB needed in $work)."
    downloaded="$work/ollie-windows-$version.iso"
    progress 2 "Downloading Windows $version"
    # curl's percentage, as 2 to 70.
    curl -fL --retry 5 --retry-delay 5 -C - --progress-bar -o "$downloaded.part" "$link" 2>&1 >/dev/null |
        stdbuf -o0 tr '\r' '\n' | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^[0-9.]+%$/) {p = int(2 + $i * 68 / 100); if (p != last) {print "PROGRESS " p " Downloading Windows '"$version"'"; fflush(); last = p}}}'
    ((PIPESTATUS[0] == 0)) || die "downloading Windows $version stopped (is the internet on?). Try again: it goes on from where it stopped."
    mv "$downloaded.part" "$downloaded"
    iso="$downloaded"
fi
if [[ -d $iso ]]; then
    src="$iso"
else
    [[ -s $iso ]] || die "$iso is not there."
    if mount -o loop,ro -t udf "$iso" "$tmp/iso" 2>/dev/null || mount -o loop,ro "$iso" "$tmp/iso" 2>/dev/null; then
        src="$tmp/iso"
    else
        die "$iso could not be opened (is it a Windows ISO?)."
    fi
fi
image=""
for f in "$src"/sources/install.wim "$src"/sources/install.esd "$src"/sources/install.swm; do [[ -f $f ]] && image="$f" && break; done
[[ -n $image && -f "$src/efi/boot/bootx64.efi" && -f "$src/sources/boot.wim" ]] ||
    die "this is not a Windows 10 or 11 ISO (no Windows Setup for 64-bit computers in it)."
if [[ -f "$src/sources/idwbinfo.txt" ]] && grep -qi 'arm64' "$src/sources/idwbinfo.txt"; then
    die "this is Windows for ARM computers: this computer needs the x64 one."
fi

# --- Is the ISO whole? Checked before anything is put on the drive ------------------------------
command -v wimlib-imagex >/dev/null || die "wimlib is missing (Update Ollie OS adds it)."
progress 66 "Checking the Windows file is whole"
for f in "$src"/sources/boot.wim "$image"; do
    case "$f" in *.swm) wimlib-imagex verify "$f" --ref="${f%.swm}*.swm" >/dev/null 2>&1 ;; *) wimlib-imagex verify "$f" >/dev/null 2>&1 ;; esac ||
        die "$(basename "$f") in the Windows file is damaged (a download that did not finish, or a bad copy). Download it again, or pick another file."
done

# --- The way Windows goes on: Windows Setup, or (a drive connected by USB, which Setup refuses) ---
# Ollie OS's own way: the Windows image then goes on the NTFS part for Windows itself (no 4 GB
# limit, nothing split or converted), and the Windows Setup part only starts the script that applies it.
usb_on=""
if [[ $usb == yes ]]; then
    usb_on=1
elif [[ $usb == auto && -n $efi_vars ]]; then
    d="$(lsblk -no PKNAME "$part" 2>/dev/null | head -n 1)"
    [[ -n $d && "$(lsblk -dno TRAN "/dev/$d" 2>/dev/null | head -n 1)" == usb ]] && usb_on=1
fi

# --- Onto the Windows Setup part (FAT32, which every computer can start from) --------------------
progress 72 "Putting Windows Setup on the drive"
umount "$part" 2>/dev/null
mkfs.fat -F 32 -n WINSETUP "$part" >/dev/null || die "the Windows Setup part could not be formatted."
mount "$part" "$tmp/setup" || die "the Windows Setup part could not be opened."
# Everything but the Windows image itself (a FAT32 file can be at most 4 GB).
skip=()
[[ -n $usb_on ]] && skip=(! -path './sources/install*.swm') # (the USB way: the image does not go on this part)
(cd "$src" && find . -type f ! -path ./sources/install.wim ! -path ./sources/install.esd "${skip[@]}" -print0) |
    while IFS= read -r -d '' f; do
        install -D -m 0644 "$src/$f" "$tmp/setup/$f" || exit 1
    done || die "copying Windows Setup failed (is the drive full?)."
progress 80 "Putting Windows on the drive"
size="$(stat -c %s "$image")"
if [[ -n $usb_on ]]; then
    : # the image goes on the NTFS part for Windows, below
elif [[ $image == *.swm ]]; then
    cp "$src"/sources/install*.swm "$tmp/setup/sources/" || die "copying Windows failed."
elif ((size < 4 * 1024 * 1024 * 1024 - 1)); then
    cp "$image" "$tmp/setup/sources/" || die "copying Windows failed."
else
    # Windows Setup reads it in parts too (install.swm, install2.swm...).
    if [[ $image == *.esd ]]; then
        wimlib-imagex export "$image" all "$work/ollie-install.wim" --compress=LZX >/dev/null || die "converting Windows failed."
        image="$work/ollie-install.wim"
    fi
    wimlib-imagex split "$image" "$tmp/setup/sources/install.swm" 3800 >/dev/null || die "putting Windows on the drive failed (is it full?)."
    rm -f "$work/ollie-install.wim"
fi

progress 94 "Getting Windows Setup ready"
# --- Windows' answer file -------------------------------------------------------------------
# The account the Add Windows Updater asked for (a file only root can read:
# USER, COMPUTER, PASSWORD_B64 = base64 of UTF-16 "password" + "Password", the way
# answer files keep it). Windows then sets itself up with no questions: it
# makes that account, and its login screen asks for the password.
acct_file="${OLLIE_WINDOWS_ACCOUNT:-${root%/}/var/lib/ollie/windows-account}"
acct_user="" acct_comp="" acct_pw=""
if [[ -r $acct_file ]]; then
    u="$(sed -n 's/^USER=//p' "$acct_file" | head -n 1)" c="$(sed -n 's/^COMPUTER=//p' "$acct_file" | head -n 1)" w="$(sed -n 's/^PASSWORD_B64=//p' "$acct_file" | head -n 1)"
    if [[ $u =~ ^[A-Za-z0-9][A-Za-z0-9\ _-]{0,19}$ && $c =~ ^[A-Za-z0-9-]{1,15}$ && $w =~ ^[A-Za-z0-9+/=]+$ ]]; then
        acct_user=$u acct_comp=$c acct_pw=$w
    else
        die "the Windows account file is not in the right form: run the Add Windows Updater again."
    fi
fi
# Windows' name for the time zone (a few; else Windows keeps its own).
tz=""
case "$(readlink "${root%/}/etc/localtime" 2>/dev/null | sed -n 's|.*/zoneinfo/||p')" in
America/Los_Angeles) tz="Pacific Standard Time" ;;
America/Denver) tz="Mountain Standard Time" ;;
America/Phoenix) tz="US Mountain Standard Time" ;;
America/Chicago) tz="Central Standard Time" ;;
America/New_York) tz="Eastern Standard Time" ;;
America/Anchorage) tz="Alaskan Standard Time" ;;
Pacific/Honolulu) tz="Hawaiian Standard Time" ;;
Europe/London) tz="GMT Standard Time" ;;
UTC | Etc/UTC) tz="UTC" ;;
esac
unattend_xml() { # unattend_xml WITH_BYPASS WITH_ACCOUNT: the answer file, on stdout
    echo '<?xml version="1.0" encoding="utf-8"?>'
    echo '<!-- Ollie OS: no questions. Windows 11 installs on computers without TPM 2.0 or Secure Boot too (when asked),'
    echo '     and Windows makes the account that was asked for. -->'
    echo '<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
    if [[ -n $1 ]]; then
        cat <<'XML'
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add"><Order>1</Order><Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add"><Order>2</Order><Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add"><Order>3</Order><Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add"><Order>4</Order><Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add"><Order>5</Order><Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
XML
    fi
    if [[ -n $2 ]]; then
        cat <<XML
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>$acct_comp</ComputerName>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>$acct_user</Name>
            <DisplayName>$acct_user</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value>$acct_pw</Value>
              <PlainText>false</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>${tz:+
      <TimeZone>$tz</TimeZone>}
    </component>
  </settings>
XML
    fi
    echo '</unattend>'
}
# Where it goes depends on the way Windows is put on: with Windows Setup
# (autounattend.xml, at the root of the Windows Setup part), or the USB way
# (ollie-unattend.xml, which the script copies into Windows; see below).
if [[ -z $usb_on ]] && [[ $version == 11 || -n $acct_user ]]; then
    umask 077
    unattend_xml "$([[ $version == 11 ]] && echo 1)" "$acct_user" >"$tmp/setup/autounattend.xml"
    umask 022
fi
# Ollie OS's menu as Windows Boot Manager's program: with Secure Boot set up,
# through shim (the menu alone is signed only with Ollie OS's own key).
menu='\EFI\systemd\systemd-bootx64.efi'
[[ -f ${root%/}/boot/EFI/ollie/shimx64.efi ]] && menu='\EFI\ollie\shimx64.efi'
if [[ -n $usb_on ]]; then
    sc_boot="rem Ollie OS (USB way): Windows start-up files are on Ollie OS start-up part already.
rem Windows is set up: Ollie OS stops restarting into it (ollie-windows-finish).
echo done>%SystemDrive%\\ollie-windows-ready.txt"
else
    sc_boot="rem Ollie OS: Windows Boot Manager starts Ollie OS's start-up menu (both are on it).
bcdedit /set {bootmgr} path $menu"
fi
install -D -m 0644 /dev/stdin "$tmp/setup/sources/\$OEM\$/\$\$/Setup/Scripts/SetupComplete.cmd" <<EOF
@echo off
$sc_boot
rem The clock in UTC, like Ollie OS, so the time is right after switching.
reg add "HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation" /v RealTimeIsUniversal /t REG_DWORD /d 1 /f
rem No automatic BitLocker: it would ask for a recovery key because of the menu.
reg add "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" /v PreventDeviceEncryption /t REG_DWORD /d 1 /f
EOF
sed -i 's/$/\r/' "$tmp/setup/sources/\$OEM\$/\$\$/Setup/Scripts/SetupComplete.cmd"
sync
umount "$tmp/setup"
# --- Is the copy on the drive whole? Read back from the drive itself -------------------------------
progress 90 "Checking the copy on the drive"
mount -o ro "$part" "$tmp/setup" || die "the Windows Setup part could not be opened again to check it."
bad=""
while IFS= read -r -d '' f; do
    case "$f" in ./sources/install.wim | ./sources/install.esd | ./sources/install*.swm | ./autounattend.xml) continue ;; esac
    cmp -s "$src/$f" "$tmp/setup/$f" || { bad="$f"; break; }
done < <(cd "$src" && find . -type f -print0)
if [[ -z $bad ]]; then
    if [[ -f "$tmp/setup/sources/install.swm" ]]; then
        wimlib-imagex verify "$tmp/setup/sources/install.swm" --ref="$tmp/setup/sources/install*.swm" >/dev/null 2>&1 || bad="sources/install.swm"
    elif [[ -f "$tmp/setup/sources/install.wim" ]]; then
        wimlib-imagex verify "$tmp/setup/sources/install.wim" >/dev/null 2>&1 || bad="sources/install.wim"
    fi
fi
umount "$tmp/setup"
[[ -z $bad ]] || die "the copy of $bad on the drive is not the same as in the Windows file (is the drive failing, or full?). Nothing was started."

# --- A drive Windows Setup will not install to (USB): Ollie OS does Setup's job itself ----------------
if [[ -n $usb_on ]]; then
    progress 91 "This drive is connected by USB: Windows Setup would refuse it, so Windows is put on another way"
    usbcmd="${OLLIE_WINDOWS_USB_CMD:-/usr/local/share/ollie/windows-usb-install.cmd}"
    [[ -r $usbcmd ]] || die "windows-usb-install.cmd is missing (Update Ollie OS adds it)."
    command -v mkfs.ntfs >/dev/null && command -v ntfscp >/dev/null && command -v ntfscat >/dev/null || die "ntfs-3g's tools are missing (Update Ollie OS adds them)."

    # 1. The part Windows goes in: empty NTFS, in the free room (called OLLIE_WINDOWS).
    wpart="$winpart"
    if [[ -z $wpart ]]; then
        # shellcheck source=/dev/null
        . "${OLLIE_WINDOWS_LAYOUT:-/usr/local/lib/ollie/windows-layout}"
        disk="/dev/$(lsblk -no PKNAME "$part" | head -n 1)"
        wpart="$(lsblk -lnpo NAME,PARTLABEL "$disk" | awk '$2 == "OLLIE_WINDOWS" {print $1; exit}')"
        if [[ -z $wpart ]]; then
            read -r fstart fsectors <<<"$(wl_largest_free "$disk")"
            fss="$(wl__ss "$disk")"
            [[ -n ${fstart:-} && -n ${fss:-} ]] || die "there is no free room on the drive for Windows."
            fend=$(((fstart + fsectors) * fss / 1048576 * 1048576 / fss - 1)) # the end on a 1 MiB boundary
            ((fend - fstart + 1 >= 30 * 1073741824 / fss)) || die "the free room on the drive is under 30 GB: not enough for Windows and its image."
            sgdisk -n "0:$fstart:$fend" -t 0:0700 -c 0:OLLIE_WINDOWS "$disk" >/dev/null || die "the part for Windows could not be made."
            partx -a "$disk" 2>/dev/null
            udevadm settle 2>/dev/null
            for _ in $(seq 1 20); do
                wpart="$(lsblk -lnpo NAME,PARTLABEL "$disk" | awk '$2 == "OLLIE_WINDOWS" {print $1; exit}')"
                [[ -n $wpart ]] && break
                sleep 1
            done
        fi
    fi
    [[ -n $wpart && -b $wpart ]] || die "the part for Windows is not there."
    progress 92 "Making the part for Windows (NTFS)"
    umount "$wpart" 2>/dev/null
    # A Windows already on it (put on by an earlier run) is never formatted over.
    if command -v ntfsls >/dev/null && ntfsls "$wpart" 2>/dev/null | grep -qx Windows; then
        die "there is already a Windows on the part for Windows ($wpart). Choose \"Replace it\" in the Add Windows Updater to erase it first."
    fi
    mkfs.ntfs -Q -F -L Windows "$wpart" >/dev/null 2>&1 || die "the part for Windows could not be formatted (NTFS)."
    echo "Ollie OS: Windows goes here" >"$tmp/target-marker"
    ntfscp -f "$wpart" "$tmp/target-marker" OLLIE-WINDOWS-TARGET >/dev/null 2>&1 || die "the part for Windows could not be marked."

    # 1b. The Windows image itself, onto that NTFS part (the script applies it from there and deletes it).
    progress 92 "Putting the Windows image on the part for Windows (several minutes)"
    case "$image" in
    *.swm)
        for f in "$src"/sources/install*.swm; do
            b="$(basename "$f")"
            ntfscp -f "$wpart" "$f" "ollie-image${b#install}" >/dev/null 2>&1 || die "copying Windows to its part failed (is it full?)."
        done
        ;;
    *.esd) ntfscp -f "$wpart" "$image" ollie-image.esd >/dev/null 2>&1 || die "copying Windows to its part failed (is it full?)." ;;
    *) ntfscp -f "$wpart" "$image" ollie-image.wim >/dev/null 2>&1 || die "copying Windows to its part failed (is it full?)." ;;
    esac
    progress 93 "Checking the Windows image on its part"
    case "$image" in
    *.swm)
        for f in "$src"/sources/install*.swm; do
            b="$(basename "$f")"
            ntfscat -f "$wpart" "ollie-image${b#install}" 2>/dev/null | cmp -s - "$f" || die "the copy of $b on the part for Windows is not the same as in the Windows file (is the drive failing?)."
        done
        ;;
    *) ntfscat -f "$wpart" "ollie-image.${image##*.}" 2>/dev/null | cmp -s - "$image" || die "the copy of Windows on its part is not the same as in the Windows file (is the drive failing, or full?)." ;;
    esac

    # 2. On the Windows Setup part: a marker, the edition to put on (Pro if there is one), and the script in Setup's start-up image.
    mount "$part" "$tmp/setup" || die "the Windows Setup part could not be opened again."
    echo "Ollie OS: Windows Setup part" >"$tmp/setup/ollie-setup-marker"
    if [[ -n $acct_user ]]; then
        umask 077
        unattend_xml "" "$acct_user" >"$tmp/setup/ollie-unattend.xml"
        umask 022
    fi
    idx="$(wimlib-imagex info "$image" 2>/dev/null | awk '
        /^Index:/ {i = $2}
        /^Name:/ {n = $0; sub(/^Name: */, "", n); if (!first) first = i; if (n ~ /^Windows [0-9]+ Pro$/ && !pro) pro = i}
        END {print (pro ? pro : (first ? first : 1))}')"
    printf '%s\r\n' "$idx" >"$tmp/setup/ollie-image-index.txt"
    boot_wim="$tmp/setup/sources/boot.wim"
    bidx="$(wimlib-imagex info "$boot_wim" 2>/dev/null | awk '
        /^Index:/ {i = $2; last = i}
        /^Name:/ && tolower($0) ~ /setup/ {setupi = i}
        END {print (setupi ? setupi : (last ? last : 1))}')"
    sed 's/$/\r/' "$usbcmd" >"$tmp/ollie-usb-install.cmd"
    printf '[LaunchApps]\r\n%%SYSTEMROOT%%\\System32\\cmd.exe, /k %%SYSTEMROOT%%\\System32\\ollie-usb-install.cmd\r\n' >"$tmp/winpeshl.ini"
    progress 93 "Putting the Windows script into Windows Setup's start-up image"
    wimlib-imagex update "$boot_wim" "$bidx" >/dev/null 2>&1 <<WIMEOF || die "the script could not be put into Windows Setup's start-up image (is the drive full?)."
add '$tmp/ollie-usb-install.cmd' '/Windows/System32/ollie-usb-install.cmd'
add '$tmp/winpeshl.ini' '/Windows/System32/winpeshl.ini'
WIMEOF
    wimlib-imagex verify "$boot_wim" >/dev/null 2>&1 || die "Windows Setup's start-up image is damaged after the change."
    sync
    umount "$tmp/setup"
    usb_note=1
fi

# Noted for Ollie OS: the menu says "Windows 11" (or 10) once it is installed.
install -D -m 0644 /dev/stdin "$root/etc/ollie/windows" <<EOF
VERSION=$version${usb_note:+
USB=1}
SETUP=$(blkid -s PARTUUID -o value "$part")
EOF
# Ready: "Install Windows" no longer opens by itself at login (windows-plan).
rm -f "$root/etc/xdg/autostart/ollie-windows-install.desktop"

# --- Start Windows Setup at the next restart (that once) ----------------------------------------
if [[ -n $efi_vars ]] && command -v efibootmgr >/dev/null; then
    label="Install Windows $version"
    while read -r num; do efibootmgr -q -b "$num" -B >/dev/null 2>&1; done < <(efibootmgr | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\? $label\b.*/\1/p")
    efibootmgr -q -C -d "$disk" -p "$partnum" -L "$label" -l '\efi\boot\bootx64.efi' >/dev/null 2>&1
    num="$(efibootmgr | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\? $label\b.*/\1/p" | head -n 1)"
    if [[ -n $num ]] && efibootmgr -q -n "$num" >/dev/null 2>&1; then
        echo "NEXT-START Windows Setup"
    fi
fi
progress 100 "Windows Setup is ready"
