# Windows, as asked for at the end of the Drive Writer: room made for it and
# Windows Setup's part, at the drive's first start (only when the Drive
# Writer left /boot/ollie-windows-plan; usr/local/lib/ollie/windows-plan).
[Unit]
Description=Get the room for Windows ready (asked for in the Drive Writer)
ConditionPathExists=/boot/ollie-windows-plan
RequiresMountsFor=/boot
After=local-fs.target
# The login screen waits for it (the computer may restart into Windows Setup).
Before=display-manager.service sddm.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ollie/windows-plan
# Putting Windows Setup on the drive takes minutes, and shows on the console.
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
