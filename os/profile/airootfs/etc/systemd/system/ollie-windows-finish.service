# Windows put on by the USB way restarts a few times while it sets itself up,
# and each restart comes back here. Until it is finished (usr/local/bin/ollie-windows-finish),
# restart straight into it. Only while /var/lib/ollie/windows-firstboot is there.
[Unit]
Description=Go on with Windows' first start-up until it has finished
ConditionPathExists=/var/lib/ollie/windows-firstboot
After=ollie-windows-boot.service
# (before the login screen shows, so it does not flash up just before the restart)
Before=display-manager.service sddm.service
RequiresMountsFor=/boot

[Service]
Type=oneshot
ExecStart=-/usr/local/bin/ollie-windows-finish

[Install]
WantedBy=multi-user.target
