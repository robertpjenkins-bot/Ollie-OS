#!/bin/bash
# Windows Remover: takes Windows off a drive, with the parts it lives in.
# It asks which drive, lists the parts that look like Windows (the Microsoft
# reserved part, the recovery part, NTFS and BitLocker parts, and the Windows
# Setup part Ollie OS made), lets you pick which to delete, and deletes them
# only after you type DELETE. Then it takes Windows' start-up files and
# entries away, removes a Windows file it saved (about 6 GB), and, on the drive
# Ollie OS runs from, offers to give the free room back to Ollie OS (its part
# and file system get bigger). Never deletes Ollie OS's own parts, or a part you
# did not pick. No password: Ollie OS's admin rights need none. What it needs
# comes with it, in share/ollie-apps/airootfs (windows-layout).
#
#   ollie-windows-remover
set -uo pipefail

readonly TITLE="Windows Remover"
bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
say() { printf '\n%s==>%s %s%s%s\n' "$teal$bold" "$reset" "$bold" "$*" "$reset"; }
die() {
    printf '\n%sError:%s %s\n\nPress Enter to close.' "$red$bold" "$reset" "$*" >&2
    read -r _ || true
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
here="$(cd "$(dirname "$0")" && pwd)"
files="${OLLIE_APPS_SHARE:-$here/../share/ollie-apps}/airootfs"

# --- A terminal to talk in -----------------------------------------------------------
if [[ ! -t 0 && -z "${OLLIE_WINDOWS_IN_TERMINAL:-}" ]]; then
    export OLLIE_WINDOWS_IN_TERMINAL=1
    self="${APPIMAGE:-$(realpath -- "$0")}"
    for term in konsole gnome-terminal kgx xfce4-terminal xterm; do
        have "$term" || continue
        case "$term" in
        konsole) exec konsole --hold -e "$self" "$@" ;;
        gnome-terminal | kgx) exec "$term" -- "$self" "$@" ;;
        *) exec "$term" -hold -e "$self" "$@" ;;
        esac
    done
    have kdialog && kdialog --title "$TITLE" --error "No terminal program found. Run this from a terminal instead."
    exit 1
fi

printf '\n%s  %s%s  (takes Windows and its parts off a drive)\n' "$bold" "$TITLE" "$reset"
[[ -x /usr/local/bin/ollie-first-setup ]] || die "this is not Ollie OS. Run $TITLE on Ollie OS."
sudo -n true 2>/dev/null ||
    die "this Ollie OS asks for a password for admin tasks, and $TITLE never asks for one. Bring Ollie OS up to date with the Ollie OS Updater, then try again."
[[ -r $files/usr/local/lib/ollie/windows-layout ]] || die "this copy of $TITLE is missing a piece (windows-layout)."

# The part table is looked at and changed by windows-layout, as root, from a
# copy outside this app (root cannot read inside it).
layout="$(mktemp)"
trap 'rm -f "${layout:?}"' EXIT
cp "$files/usr/local/lib/ollie/windows-layout" "$layout" || die "could not unpack $TITLE (is the disk full?)."
# shellcheck source=/dev/null
. "$layout"
as_root() { # as_root FUNCTION ARGS...: a windows-layout function, as root, with the kernel and Ollie OS's file system told
    sudo -n bash -c '. "$0"
        wl_hook_kernel() {
            local info ss
            info="$(wl_part_info "$1" "$2")"
            if [[ -n $info ]]; then ss="$(wl__ss "$1")"; resizepart "$1" "$2" $((${info#* } * ss / 512)) >/dev/null 2>&1 || partx -u "$1" >/dev/null 2>&1
            else partx -d --nr "$2" "$1" >/dev/null 2>&1; fi
            return 0
        }
        wl_hook_fs_grow() { btrfs filesystem resize max / >/dev/null; }
        "$@"' "$layout" "$@"
}

# --- Which drive? --------------------------------------------------------------------------
src="$(findmnt -no SOURCE / | sed 's/\[.*//')"
ollie_disk=""
[[ -b $src ]] && ollie_disk="/dev/$(lsblk -no PKNAME "$src" 2>/dev/null | head -n 1)"
mapfile -t drives < <(lsblk -dpno NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" && $1 !~ /zram|loop|ram/ {n = $1; s = $2; $1 = $2 = $3 = ""; sub(/^ +/, ""); print n "|" s "|" $0}')
((${#drives[@]})) || die "no drives were found."
printf '\n%s1. Which drive has the Windows to remove?%s\n\n' "$bold" "$reset"
for i in "${!drives[@]}"; do
    IFS='|' read -r dname dsize dmodel <<<"${drives[i]}"
    wl_scan_windows "$dname" "$src" with_setup
    note="no Windows parts found"
    ((${#WL_WINPARTS[@]})) && note="${#WL_WINPARTS[@]} part(s) that look like Windows"
    mark=""
    [[ $dname == "$ollie_disk" ]] && mark="   <-- Ollie OS is running from this one"
    printf '  %d) %s  %s  %s  (%s)%s\n' "$((i + 1))" "$dname" "$dsize" "${dmodel:-drive}" "$note" "$mark"
done
while :; do
    read -rp "Type its number: " pick || exit 1
    if [[ $pick =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#drives[@]})); then break; fi
    echo "Please type a number from 1 to ${#drives[@]}."
done
IFS='|' read -r disk dsize dmodel <<<"${drives[pick - 1]}"
[[ "$(lsblk -dno PTTYPE "$disk" 2>/dev/null)" == gpt ]] || die "$disk is not a GPT drive (Windows on an old-style drive is not handled here)."
other=""
[[ $disk != "$ollie_disk" ]] && other=1
num="${src##*[!0-9]}"
((other)) && num=0

# --- 2. What is on it --------------------------------------------------------------------------
wl_scan_windows "$disk" "$src" with_setup
winparts=("${WL_WINPARTS[@]}") winlines=("${WL_WINLINES[@]}")
((${#winparts[@]})) || die "no parts that look like Windows were found on $disk, so there is nothing to remove."
printf '\n%s2. These parts look like Windows%s (part number, device, size, kind):\n\n' "$bold" "$reset"
printf '    %s\n' "${winlines[@]}"
printf '\nNTFS parts can also be your own files. Only pick the ones you are sure about.\n'
if ((other)); then
    printf '%sThis drive (%s) is not the one Ollie OS runs from.%s Windows may be this computer'"'"'s own Windows.\n' "$red$bold" "$disk" "$reset"
fi
while :; do
    read -rp "Type the part numbers to delete, like 3,4,5 (all: every one listed; n: stop): " picks || exit 1
    if [[ ${picks,,} == n* ]]; then
        printf '\nOK, nothing was changed.\n'
        exit 0
    fi
    [[ ${picks,,} == all ]] && picks="${winparts[*]}"
    picks="${picks//,/ }"
    ok=1 todel=()
    for p in $picks; do
        [[ " ${winparts[*]} " == *" $p "* ]] || {
            echo "$p is not one of the listed parts."
            ok=""
            break
        }
        todel+=("$p")
    done
    [[ -n $ok && ${#todel[@]} -gt 0 ]] && break
done

# --- 3. Sure? ----------------------------------------------------------------------------------------
printf '\n%sThese will be ERASED, with everything on them, and cannot be got back:%s\n' "$red$bold" "$reset"
for l in "${winlines[@]}"; do
    for p in "${todel[@]}"; do [[ $l == "$p "* ]] && printf '    %s\n' "$l"; done
done
printf '\n(Ollie OS'"'"'s own parts are never deleted. Plug a laptop in; ask a grown-up to say yes.)\n'
read -rp "Type DELETE to erase them: " answer || exit 1
if [[ $answer != DELETE ]]; then
    printf '\nOK, nothing was changed.\n'
    exit 0
fi
if ((other)); then
    read -rp "This is not Ollie OS's drive. Type its name ($(basename "$disk")) to be sure: " answer || exit 1
    [[ $answer == "$(basename "$disk")" ]] || {
        printf '\nOK, nothing was changed.\n'
        exit 0
    }
fi

# --- 4. Delete ---------------------------------------------------------------------------------------
for p in "${todel[@]}"; do
    for dev in "${disk}${p}" "${disk}p${p}"; do
        [[ -b $dev ]] || continue
        if findmnt -rn -S "$dev" >/dev/null 2>&1; then
            sudo -n umount "$dev" || die "$dev is in use: close what is using it (or Windows' files), then try again."
        fi
    done
done
say "Deleting the parts"
as_root wl_delete_parts "$disk" "$num" "${todel[@]}" || die "the parts could not be deleted (see above)."
echo "Deleted."

say "Taking Windows' start-up files away"
# (Only Ollie OS's own start-up part and the computer's start-up list are
# looked at; another drive's start-up files are not touched.)
as_root wl_clean_windows_boot
sudo -n rm -f /var/lib/ollie/windows-10.iso /var/lib/ollie/windows-11.iso /boot/ollie-windows-plan 2>/dev/null
sudo -n rm -f /etc/xdg/autostart/ollie-windows-install.desktop 2>/dev/null
echo "Done."

# --- 5. The room back to Ollie OS ------------------------------------------------------------------
if ((!other)); then
    printf '\n%s3. Give the free room back to Ollie OS?%s\n' "$bold" "$reset"
    printf 'Ollie OS'"'"'s part (and its file system) gets as big as the free room right after it allows.\n'
    read -rp "Give it back? [Y/n] " answer || exit 1
    if [[ ${answer,,} != n* ]]; then
        say "Making Ollie OS bigger"
        as_root wl_grow_root "$disk" "$num" || echo "(It could not be made bigger now. The room is free: run $TITLE again, or use the Disks app.)"
    fi
fi

printf '\n%s  Done.%s Windows and its parts are gone from %s.\n' "$green$bold" "$reset" "$disk"
printf '\nPress Enter to close.'
read -r _ || true
