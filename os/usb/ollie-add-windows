#!/bin/bash
# Windows Updater: on an Ollie OS that is already installed (on a drive or
# inside a computer), adds Windows 10 or 11 next to Ollie OS, the way the
# Drive Writer and the Installer do it when you say yes to Windows. It asks:
#   1. Windows 10 or 11,
#   2. a regular computer (Intel / AMD) or an ARM one (Ollie OS is for regular
#      ones, so ARM Windows cannot be added: it says so),
# then looks, and tells what it found:
#   - a Windows already on this computer: it offers to put that one on Ollie
#     OS's start-up menu instead of adding another,
#   - a Windows .iso in Downloads (or the Desktop, the home folder): it is used,
#   - none: Windows is downloaded from Microsoft (about 6 GB; if Microsoft says
#     no, the browser page opens and the file is picked up from Downloads),
# and then asks
#   3. which drive has Ollie OS on it (it can only change the drive it is
#      running from; parts that come after Ollie OS's are left alone),
#   4. how much room Windows gets (and checks Ollie OS has it to give).
# It keeps the Windows .iso in /var/lib/ollie, adds what Ollie OS needs for it
# (Install Windows in the apps menu, Restart into Windows, the Windows start-up
# menu entry) and leaves the plan (/boot/ollie-windows-plan). At the next start
# Ollie OS's part is made smaller and the room (and a 10 GB Windows Setup part)
# is made (usr/local/lib/ollie/windows-plan); at the login after that "Install
# Windows" opens, puts Windows on the Setup part and starts it.
# When Windows is installed, it is on Ollie OS's start-up menu.
# Nothing of Ollie OS's own files is deleted. Windows needs its own licence
# (a product key); this does not include one. No password: Ollie OS's admin
# rights need none. What it adds comes with it, in share/ollie-apps/airootfs.
#
#   ollie-add-windows
set -uo pipefail

readonly TITLE="Windows Updater"
readonly DEFAULT_GB=64
readonly ISO_GB=7 # the download (about 6 GB), kept on Ollie OS until Setup has it
readonly GiB=1073741824
bold=$'\e[1m' teal=$'\e[36m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
say() { printf '\n%s==>%s %s%s%s\n' "$teal$bold" "$reset" "$bold" "$*" "$reset"; }
die() {
    printf '\n%sError:%s %s\n\nNothing was changed that matters. Press Enter to close.' "$red$bold" "$reset" "$*" >&2
    read -r _ || true
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }
here="$(cd "$(dirname "$0")" && pwd)"
files="${OLLIE_APPS_SHARE:-$here/../share/ollie-apps}/airootfs"

# --- A terminal to talk in -----------------------------------------------------------
if [[ ! -t 0 && -z "${OLLIE_WINDOWS_IN_TERMINAL:-}" ]]; then
    export OLLIE_WINDOWS_IN_TERMINAL=1
    self="${APPIMAGE:-$(realpath -- "$0")}"
    for term in konsole gnome-terminal kgx xfce4-terminal xterm; do
        have "$term" || continue
        case "$term" in
        konsole) exec konsole --hold -e "$self" "$@" ;;
        gnome-terminal | kgx) exec "$term" -- "$self" "$@" ;;
        *) exec "$term" -hold -e "$self" "$@" ;;
        esac
    done
    have kdialog && kdialog --title "$TITLE" --error "No terminal program found. Run this from a terminal instead."
    exit 1
fi

printf '\n%s  %s%s  (adds Windows 10 or 11 next to Ollie OS)\n' "$bold" "$TITLE" "$reset"
[[ -x /usr/local/bin/ollie-first-setup ]] || die "this is not Ollie OS. Run $TITLE on the Ollie OS you want Windows added to."
sudo -n true 2>/dev/null ||
    die "this Ollie OS asks for a password for admin tasks, and $TITLE never asks for one. Bring Ollie OS up to date with the Ollie OS Updater, then try again."
[[ -d $files ]] || die "this copy of $TITLE has nothing inside to add."
[[ -d /sys/firmware/efi ]] ||
    die "this computer started the old way (BIOS / Legacy). Windows needs it to start the new way (UEFI): change it in the computer's start-up settings."

install_files() { # what Ollie OS needs for Windows, from inside this app
    # (Inside this app only you can read: root installs from a copy outside it.)
    local tmp path rel mode
    tmp="$(mktemp -d)"
    cp -a "$files/." "$tmp/" || { rm -rf "${tmp:?}"; die "could not unpack $TITLE (is the disk full?)."; }
    while IFS= read -r -d '' path; do
        rel="${path#"$tmp/"}" mode=0644
        [[ -x $path ]] && mode=0755
        sudo -n install -D -m "$mode" "$path" "/$rel" || { rm -rf "${tmp:?}"; die "could not add /$rel to Ollie OS."; }
    done < <(find "$tmp" -type f -print0)
    rm -rf "${tmp:?}"
    have kbuildsycoca6 && kbuildsycoca6 >/dev/null 2>&1
    return 0
}

# --- 1. Windows 10 or 11? -------------------------------------------------------------------
printf '\n%s1. Which Windows?%s\n\n  1) Windows 10   (no security updates from Microsoft any more)\n  2) Windows 11   (safer; needs about 64 GB of room)\n' "$bold" "$reset"
while :; do
    read -rp "Type 1 or 2: " w || exit 1
    case "$w" in 1) VERSION=10 ;; 2) VERSION=11 ;; *) echo "Please type 1 or 2."; continue ;; esac
    break
done
((VERSION == 11)) && MIN_GB=64 || MIN_GB=32

# --- 2. Regular computer or ARM? ------------------------------------------------------------
printf '\n%s2. Is this computer an ARM one?%s\n\n  1) No: a regular computer (Intel or AMD), like most laptops and desktops\n  2) Yes: ARM (some Windows tablets and laptops, Apple M-chip Macs)\n' "$bold" "$reset"
while :; do
    read -rp "Type 1 or 2: " a || exit 1
    case "$a" in 1) arm=0 ;; 2) arm=1 ;; *) echo "Please type 1 or 2."; continue ;; esac
    break
done
if ((arm)); then
    die "Ollie OS is made for regular (Intel / AMD) computers, so it cannot run Windows for ARM next to it. Nothing was changed."
fi
if [[ "$(uname -m)" != x86_64 ]]; then
    die "this computer says it is not a regular (x86_64) one (it says $(uname -m)). Windows $VERSION for regular computers would not run on it."
fi

iso="/var/lib/ollie/windows-$VERSION.iso"
# --- Is a Windows already on this computer? --------------------------------------------------
# (Its Windows Boot Manager is in the computer's start-up list.) If so, it only
# needs to be put on Ollie OS's start-up menu; no second Windows is needed.
if [[ ! -f /boot/loader/entries/windows.conf ]] && sudo -n efibootmgr 2>/dev/null | grep -qi 'Windows Boot Manager'; then
    printf '\n%sWindows is already on this computer%s (its Windows Boot Manager is in the start-up list).\n' "$green$bold" "$reset"
    read -rp "Put it on Ollie OS's start-up menu now, instead of adding another Windows? [Y/n] " answer || exit 1
    if [[ ${answer,,} != n* ]]; then
        say "Putting Windows on Ollie OS's start-up menu"
        install_files
        sudo -n /usr/local/bin/ollie-windows-boot || die "Windows could not be put on the start-up menu (see above)."
        printf '\n%s  Done.%s When the computer starts from the Ollie OS drive, pick "Windows Boot Manager"\n' "$green$bold" "$reset"
        printf '  in its menu. From Ollie OS: apps menu > System > Restart into Windows.\n\nPress Enter to close.'
        read -r _ || true
        exit 0
    fi
fi

dl="$(xdg-user-dir DOWNLOAD 2>/dev/null)"
dl="${dl:-$HOME/Downloads}"
# A Windows .iso already on this computer (Downloads, Desktop, the home folder):
# files named like Win10_...iso or Windows11...iso, newest first, ones for the
# Windows picked here first. The result is told before anything else happens.
mine=""
if [[ -s $iso ]]; then
    printf "\nA Windows %s .iso was saved on this computer before (%s): it will be used, nothing to download.\n" "$VERSION" "$iso"
else
    printf '\n%sLooking for a Windows %s .iso in %s and the Desktop...%s\n' "$bold" "$VERSION" "$dl" "$reset"
    mapfile -t cands < <(
        find "$dl" "$HOME/Desktop" "$HOME" -maxdepth 1 -type f -iname '*.iso' \( -iname 'win*' \) -size +3G -printf '%T@ %p\n' 2>/dev/null |
            sort -rn | cut -d ' ' -f 2- | awk -v v="$VERSION" '!seen[$0]++ {if (tolower($0) ~ "win(dows)?[ _-]?" v) a[++n] = $0; else b[++m] = $0} END {for (i = 1; i <= n; i++) print a[i]; for (i = 1; i <= m; i++) print b[i]}'
    )
    if ((${#cands[@]})); then
        printf '\nFound on this computer:\n'
        for i in "${!cands[@]}"; do
            ((i < 5)) && printf '  %d) %s  (%s)\n' "$((i + 1))" "${cands[i]}" "$(du -h --apparent-size "${cands[i]}" | cut -f 1)"
        done
        while :; do
            read -rp "Use one of these as Windows $VERSION? Type its number, or n to download it instead [1] " pick || exit 1
            pick="${pick:-1}"
            if [[ ${pick,,} == n* ]]; then
                echo "OK: Windows $VERSION will be downloaded from Microsoft."
                break
            fi
            if [[ $pick =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#cands[@]} && pick <= 5)); then
                mine="${cands[pick - 1]}"
                printf 'OK: %s will be used (nothing to download).\n' "$mine"
                break
            fi
            echo "Please type a number from 1 to $((${#cands[@]} < 5 ? ${#cands[@]} : 5)), or n."
        done
    else
        echo "No Windows .iso there: Windows $VERSION will be downloaded from Microsoft."
    fi
fi

# --- 3. Which drive has Ollie OS on it? ----------------------------------------------------
# (Windows is added to the drive Ollie OS is running from: it makes that
# drive's Ollie OS part smaller. Another drive needs its own Ollie OS start.)
src="$(findmnt -no SOURCE / | sed 's/\[.*//')"
[[ "$(findmnt -no FSTYPE /)" == btrfs && -b $src ]] ||
    die "Ollie OS's part is not the kind this can make smaller (btrfs)."
disk="/dev/$(lsblk -no PKNAME "$src" | head -n 1)"
mapfile -t drives < <(lsblk -dpno NAME,SIZE,TYPE,MODEL 2>/dev/null | awk '$3 == "disk" && $1 !~ /zram|loop|ram/ {n = $1; s = $2; $1 = $2 = $3 = ""; sub(/^ +/, ""); print n "|" s "|" $0}')
printf '\n%s3. Which drive has Ollie OS on it?%s\n\n' "$bold" "$reset"
for i in "${!drives[@]}"; do
    IFS='|' read -r dname dsize dmodel <<<"${drives[i]}"
    mark=""
    [[ $dname == "$disk" ]] && mark="   <-- Ollie OS is running from this one"
    printf '  %d) %s  %s  %s%s\n' "$((i + 1))" "$dname" "$dsize" "${dmodel:-drive}" "$mark"
done
while :; do
    read -rp "Type its number: " pick || exit 1
    if [[ $pick =~ ^[0-9]+$ ]] && ((pick >= 1 && pick <= ${#drives[@]})); then break; fi
    echo "Please type a number from 1 to ${#drives[@]}."
done
IFS='|' read -r chosen _ <<<"${drives[pick - 1]}"
if [[ $chosen != "$disk" ]]; then
    die "Ollie OS is running from $disk, not $chosen. Windows can only be added to the drive Ollie OS is running from. Start the computer from the Ollie OS drive you want (hold F12 / Option / Volume Down), then run $TITLE again."
fi

# --- Windows already on this drive? -----------------------------------------------------------
# The part table is looked at (and changed) by windows-layout, as root, from a
# copy outside this app (root cannot read inside it).
num="${src##*[!0-9]}" # the part number is the digits at the end of its name (sda2, nvme0n1p2)
[[ -n $num ]] || die "Ollie OS's part could not be looked up on $disk."
[[ "$(lsblk -dno PTTYPE "$disk")" == gpt ]] ||
    die "$disk is not a GPT drive, so room for Windows cannot be made on it."
[[ -r $files/usr/local/lib/ollie/windows-layout ]] || die "this copy of $TITLE is missing a piece (windows-layout)."
layout="$(mktemp)"
trap 'rm -f "${layout:?}"' EXIT
cp "$files/usr/local/lib/ollie/windows-layout" "$layout" || die "could not unpack $TITLE (is the disk full?)."
as_root() { # as_root FUNCTION ARGS...: a windows-layout function, as root (the kernel told with partx)
    sudo -n bash -c '. "$0"; wl_hook_kernel() { if [[ $2 == new ]]; then partx -a "$1" >/dev/null 2>&1; else partx -d --nr "$2" "$1" >/dev/null 2>&1; fi; return 0; }; "$@"' "$layout" "$@"
}
field() { sed -n "s/.*\\b$2=\"\\([^\"]*\\)\".*/\\1/p" <<<"$1"; }

# Parts that look like Windows' own on this drive: the Microsoft reserved part,
# the recovery part, NTFS and BitLocker parts. (NTFS ones can also be your own
# files: nothing is deleted without you picking it and typing DELETE.)
winparts=() winlines=()
while IFS= read -r line; do
    pname="$(field "$line" NAME)" ptype="$(field "$line" PARTTYPE)" pfs="$(field "$line" FSTYPE)" plabel="$(field "$line" PARTLABEL)"
    [[ -n $pname && $pname != "$src" ]] || continue
    [[ $plabel == OLLIE_* ]] && continue
    kind=""
    case "${ptype,,}" in
    e3c9e316-0b5c-4db8-817d-f92df00215ae) kind="Microsoft reserved (Windows)" ;;
    de94bba4-06d1-4d40-a16a-bfd50179d6ac | de94bbab-06d1-4d40-a16a-bfd50179d6ac) kind="Windows recovery" ;;
    esac
    [[ -z $kind && ( $pfs == ntfs || $pfs == BitLocker ) ]] && kind="$pfs (Windows, or your own files)"
    [[ -n $kind ]] || continue
    pn="${pname##*[!0-9]}"
    [[ -n $pn ]] || continue
    winparts+=("$pn")
    psize="$(numfmt --to=iec --suffix=B "$(field "$line" SIZE)" 2>/dev/null)"
    winlines+=("$(printf '%s  %s  %s  %s' "$pn" "$pname" "$psize" "$kind${plabel:+  \"$plabel\"}")")
done < <(lsblk -bnPpo NAME,PARTTYPE,FSTYPE,PARTLABEL,SIZE "$disk" 2>/dev/null | grep 'NAME="/dev/')
if ((${#winparts[@]})) || [[ -f /boot/loader/entries/windows.conf ]]; then
    printf '\n%sWindows seems to be on this drive already%s.\n' "$green$bold" "$reset"
    if ((${#winparts[@]})); then
        printf 'These parts look like Windows (part number, device, size, kind):\n'
        printf '    %s\n' "${winlines[@]}"
    fi
    printf '\n  1) Delete Windows and install it fresh (you pick the parts; they are ERASED)\n'
    printf '  2) Keep it: only put it on Ollie OS'"'"'s start-up menu\n  3) Stop\n'
    while :; do
        read -rp "Type 1, 2 or 3: " w2 || exit 1
        [[ $w2 =~ ^[123]$ ]] && break
        echo "Please type 1, 2 or 3."
    done
    case "$w2" in
    3)
        printf '\nOK, nothing was changed.\n'
        exit 0
        ;;
    2)
        say "Putting Windows on Ollie OS's start-up menu"
        install_files
        sudo -n /usr/local/bin/ollie-windows-boot || die "Windows could not be put on the start-up menu (see above)."
        printf '\n%s  Done.%s Pick "Windows Boot Manager" in the start-up menu. From Ollie OS: apps menu > System > Restart into Windows.\n\nPress Enter to close.' "$green$bold" "$reset"
        read -r _ || true
        exit 0
        ;;
    1)
        ((${#winparts[@]})) || die "no parts that look like Windows were found, so there is nothing to delete here."
        while :; do
            read -rp "Type the part numbers to delete, like 3,4,5 (all: every one listed; n: stop): " picks || exit 1
            if [[ ${picks,,} == n* ]]; then
                printf '\nOK, nothing was changed.\n'
                exit 0
            fi
            [[ ${picks,,} == all ]] && picks="${winparts[*]}"
            picks="${picks//,/ }"
            ok=1 todel=()
            for p in $picks; do
                [[ " ${winparts[*]} " == *" $p "* ]] || {
                    echo "$p is not one of the listed parts."
                    ok=""
                    break
                }
                todel+=("$p")
            done
            [[ -n $ok && ${#todel[@]} -gt 0 ]] && break
        done
        printf '\n%sThese will be ERASED, with everything on them:%s\n' "$red$bold" "$reset"
        for l in "${winlines[@]}"; do
            for p in "${todel[@]}"; do [[ $l == "$p "* ]] && printf '    %s\n' "$l"; done
        done
        read -rp "Type DELETE to erase them: " answer || exit 1
        if [[ $answer != DELETE ]]; then
            printf '\nOK, nothing was changed.\n'
            exit 0
        fi
        for p in "${todel[@]}"; do
            for dev in "${disk}${p}" "${disk}p${p}"; do
                [[ -b $dev ]] || continue
                if findmnt -rn -S "$dev" >/dev/null 2>&1; then
                    sudo -n umount "$dev" || die "$dev is in use: close what is using it, then try again."
                fi
            done
        done
        say "Deleting the parts"
        as_root wl_delete_parts "$disk" "$num" "${todel[@]}" || die "the parts could not be deleted (see above)."
        # Windows' start-up files and Ollie OS's note of it go too (the new Windows makes its own).
        sudo -n rm -rf /boot/EFI/Microsoft /boot/loader/entries/windows.conf /etc/ollie/windows
        echo "Deleted. The room they held is free now."
        ;;
    esac
fi

# --- Does Ollie OS's drive have room to give? -------------------------------------------------
# (The same checks as windows-plan makes at the next start; better to hear now.)
# Windows' room is made from free room on the drive when one block is big
# enough (Ollie OS's part is not touched), else by making Ollie OS's part
# smaller; parts after it are never touched.
if [[ -e /boot/ollie-windows-plan ]]; then
    die "Windows is already waiting for the next start. Restart the computer."
fi
read -r rstart _ <<<"$(as_root wl_part_info "$disk" "$num")"
ss="$(as_root wl__ss "$disk")"
after="$(as_root wl__parts "$disk" | awk -v s="${rstart:-0}" -v ss="${ss:-512}" '$2 + 0 > s + 0 {printf "    part %s  %.1f GB  %s\n", $1, $3 * ss / 1073741824, ($5 == "-" ? "" : $5)}')"
if [[ -n $after ]]; then
    printf '\nThese come after Ollie OS on %s (they are not touched):\n%s\n' "$disk" "$after"
fi
read -r _ big_s <<<"$(as_root wl_largest_free "$disk")"
big_gb=$(((${big_s:-0} * ${ss:-512}) / GiB))
((big_gb > 0)) && printf 'The biggest free room on %s is about %s GB.\n' "$disk" "$big_gb"
free="$(sudo -n btrfs filesystem usage -b / 2>/dev/null | awk '/Free \(estimated\)/ {print $3; exit}')"
free_gb=$((${free:-0} / GiB))
# From free room: GB + 10 (Windows Setup's part) + 1. By shrinking Ollie OS's
# part: the same, and 12 + 8 + 1 more kept in Ollie OS's part, and the download.
max_free=$((big_gb - 11))
max_shrink=$((free_gb - 12 - 8 - 1 - ISO_GB))
max_gb=$max_free
((max_shrink > max_gb)) && max_gb=$max_shrink
if ((max_gb < MIN_GB)); then
    die "Windows $VERSION needs $MIN_GB GB of room. This drive has about $big_gb GB free in one piece, and Ollie OS's part has about $free_gb GB free (it needs $((MIN_GB + 12 + 8 + 1 + ISO_GB)) GB free to be made smaller and still download Windows). Free some room (delete games you do not play, or delete parts you do not need) and try again."
fi

# --- 4. How much room? ------------------------------------------------------------------------
default=$DEFAULT_GB
((default > max_gb)) && default=$max_gb
((default < MIN_GB)) && default=$MIN_GB
printf '\n%s4. How much room for Windows %s?%s\n\n' "$bold" "$VERSION" "$reset"
printf 'Windows %s needs at least %s GB. Ollie OS can give up to %s GB.\n' "$VERSION" "$MIN_GB" "$max_gb"
printf 'Games need a lot of room too, so leave Windows no more than it needs.\n\n'
while :; do
    read -rp "How many GB for Windows $VERSION? [$default] " gb || exit 1
    gb="${gb:-$default}"
    if [[ $gb =~ ^[0-9]+$ ]] && ((gb >= MIN_GB && gb <= max_gb)); then break; fi
    echo "Please type a number from $MIN_GB to $max_gb."
done

# What happens about Windows itself: told the way the earlier step found it.
if [[ -n $mine ]]; then
    getline="Windows $VERSION is not downloaded: the file you picked ($mine) is used."
    ask="Make room for Windows $VERSION? Type yes: "
elif [[ -s $iso ]]; then
    getline="Windows $VERSION is not downloaded again: the one already saved on this computer ($iso) is used."
    ask="Make room for Windows $VERSION? Type yes: "
else
    getline="Windows $VERSION is downloaded from Microsoft now (about 6 GB; it needs the internet and takes a while)."
    ask="Download Windows $VERSION and make room for it? Type yes: "
fi
if ((gb + 11 <= big_gb)); then
    roomline="Windows gets $gb GB of the free room already on $disk (and 10 GB for Windows Setup), at the
    next start of the computer. Ollie OS's part is not made smaller."
else
    roomline="Ollie OS's part of $disk will be made up to $((gb + 12)) GB smaller, at the
    next start of the computer ($gb GB of empty room for Windows, 10 GB for
    Windows Setup, 2 GB spare). It keeps all its games and files."
fi
cat <<EOF

${bold}Before this starts${reset}
  - $getline
  - $roomline
  - Making a part smaller is safe when the power stays on. Plug a laptop in
    and ask a grown-up to say yes.
  - Windows needs its own licence (a product key). It is not included.
  - If this drive has BitLocker on, or you are not sure, stop here.

EOF
read -rp "$ask" answer || exit 1
[[ ${answer,,} == yes || ${answer,,} == y ]] || {
    printf '\nOK, nothing was changed.\n'
    exit 0
}

# --- What Windows needs ------------------------------------------------------------------------
say "Checking the tools Windows needs"
need=()
have sgdisk || need+=(gptfdisk)
have sfdisk || need+=(util-linux)
have wimlib-imagex || need+=(wimlib)
have mkfs.fat || need+=(dosfstools)
have mount.ntfs-3g || have ntfs-3g || need+=(ntfs-3g)
have efibootmgr || need+=(efibootmgr)
have btrfs || need+=(btrfs-progs)
if ((${#need[@]})); then
    echo "Adding: ${need[*]}"
    sudo -n pacman -S --needed --noconfirm "${need[@]}" ||
        die "the tools could not be added (no internet?). Try again, or bring Ollie OS up to date with the Ollie OS Updater first."
fi

say "Getting Windows $VERSION"
if [[ -s $iso ]]; then
    echo "It is already downloaded ($iso)."
elif [[ -n $mine ]]; then
    echo "Keeping a copy of $mine for Windows Setup (no download needed)..."
    sudo -n install -d -m 0755 /var/lib/ollie || die "could not make /var/lib/ollie."
    sudo -n cp --reflink=auto -- "$mine" "$iso.part" || die "could not keep a copy (is the disk full? it needs about 6 GB)."
    sudo -n mv "$iso.part" "$iso" || die "could not keep the copy."
else
    # (Microsoft's own page gives the link; it works for about a day.)
    if link="$(python3 -I "$files/usr/local/lib/ollie/get-windows.py" "$VERSION")"; then
        :
    else
        # Microsoft turned the automatic download away. Do it with the browser
        # instead, and pick the file up from Downloads by itself.
        link=""
        sudo -n install -d -m 0755 /var/lib/ollie || die "could not make /var/lib/ollie."
        printf '\nMicrosoft would not let Windows be downloaded automatically (see above).\n'
        printf 'The browser can: its page opens now. Pick English and 64-bit, press Download,\n'
        printf 'and wait. When the file is in %s this goes on by itself (waits up to 60 minutes).\n\n' "$dl"
        if [[ $VERSION == 10 ]]; then page="https://www.microsoft.com/software-download/windows10ISO"; else page="https://www.microsoft.com/software-download/windows11"; fi
        xdg-open "$page" >/dev/null 2>&1 &
        found=""
        for ((i = 0; i < 720 && !${#found}; i++)); do
            while IFS= read -r -d '' f; do
                [[ -e $f.crdownload || -e $f.part ]] && continue
                s1="$(stat -c %s "$f")"
                ((s1 > 3 * GiB)) || continue
                sleep 4
                [[ "$(stat -c %s "$f")" == "$s1" ]] && { found="$f"; break; }
            done < <(find "$dl" -maxdepth 1 -type f \( -iname 'win*.iso' \) -mmin -90 -print0 2>/dev/null)
            [[ -n $found ]] || sleep 5
        done
        [[ -n $found ]] || die "no Windows .iso showed up in $dl. Run $TITLE again once it is downloaded."
        echo "Found $found: keeping a copy for Windows Setup."
        sudo -n cp --reflink=auto -- "$found" "$iso.part" || die "could not keep a copy of the download (is the disk full?)."
        sudo -n mv "$iso.part" "$iso" || die "could not keep the download."
    fi
    if [[ -n $link ]]; then
        sudo -n install -d -m 0755 /var/lib/ollie || die "could not make /var/lib/ollie."
        # A half-done download stays, so running this again goes on from where it stopped.
        sudo -n curl -fL --retry 5 --retry-delay 5 -C - --progress-bar -o "$iso.part" "$link" ||
            die "downloading Windows $VERSION stopped (is the internet on?). Run $TITLE again: it goes on from where it stopped."
        size="$(stat -c %s "$iso.part" 2>/dev/null || echo 0)"
        if ((size <= 2 * GiB)); then
            sudo -n rm -f -- "$iso.part"
            die "what came from Microsoft is too small to be Windows (it is not kept). Try again later."
        fi
        sudo -n mv "$iso.part" "$iso" || die "could not keep the download."
    fi
fi

say "Adding Install Windows to Ollie OS"
install_files
sudo -n systemctl daemon-reload
sudo -n systemctl enable ollie-windows-plan.service >/dev/null 2>&1 ||
    die "Ollie OS could not be told to make the room at the next start."

say "Leaving the plan for the next start"
# (The file is used once; ollie-windows-plan.service takes it away first.)
printf 'MENU=1\nVERSION=%s\nGB=%s\n' "$VERSION" "$gb" | sudo -n tee /boot/ollie-windows-plan >/dev/null ||
    die "the plan could not be written to the start-up part (/boot)."
sudo -n sync

printf '\n%s  Done.%s Now:\n' "$green$bold" "$reset"
cat <<EOF2
  1. Restart the computer (keep it plugged in). The first start takes a few
     minutes more: Ollie OS's part is made smaller and the room is made.
  2. At the next login "Install Windows" opens by itself. It puts the Windows $VERSION
     you downloaded onto the drive and starts Windows Setup.
  3. In Windows Setup pick "Unallocated Space": that is the room kept for
     Windows. Ollie OS is not touched.
  4. After that, Windows $VERSION is on the start-up menu next to Ollie OS: pick
     it when the computer starts (4 seconds; the arrow keys stop it).

  If it is not wanted any more before the restart: delete /boot/ollie-windows-plan
  and $iso.

Press Enter to close.
EOF2
read -r _ || true
